# Copy to .env and adjust. Never commit real secrets.

# --- Core services -------------------------------------------------------
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio
REDIS_URL=redis://127.0.0.1:6379
# Blob storage: "local" (DATA_DIR/storage) or "s3"
STORAGE_DRIVER=local
# Relative paths resolve from the repo root, so the web app and the worker use the same folder.
DATA_DIR=./data
# S3_BUCKET=video-studio
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Security --------------------------------------------------------------
# "local" = passwordless single owner, loopback only (development).
# "password" = owner account + sessions (required for any remote deployment).
STUDIO_AUTH_MODE=local
# >= 32 random characters; signs short-lived download URLs.
APP_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32); encrypts provider keys at rest.
APP_ENCRYPTION_KEY=
# One-time token required to claim the owner account in password mode.
SETUP_TOKEN=

# --- Claude runtime (PRD §28) ---------------------------------------------
# Default: "subscription" — AI actions use YOUR Claude plan (Pro/Max) through the Claude Code
# installed and signed in on this computer (run `claude`, then /login). No API key needed; the
# studio never reads or stores your Claude login. Only in a personal local studio
# (STUDIO_AUTH_MODE=local). At a plan usage limit, jobs pause; nothing falls back to an API key.
# "api" — a separately billed ANTHROPIC_API_KEY (explicit opt-in; required for multi-user studios).
# "off" — no AI actions. The choice can also be made in Settings → Claude.
# CLAUDE_RUNTIME=subscription
# CLAUDE_CODE_EXECUTABLE=              # path to `claude` if not the SDK's bundled runtime
# CLAUDE_RUNTIME_TIMEOUT_MS=900000     # upper bound for one AI call
# STUDIO_CLAUDE_WORKDIR=               # parent of per-call scratch dirs (default: OS temp dir)
# Note: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL in the server environment
# are never passed to Claude Code in subscription mode; Settings warns when they are present.
# STUDIO_ALLOWED_ORIGINS=              # extra browser origins allowed to call the API (comma-separated)

# --- Providers (optional; can also be set in Settings, stored encrypted) --
# Claude API key: only used when the runtime is "api".
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=32000
# CLAUDE_FALLBACKS=on                 # server-side model fallbacks (beta); "off" to disable
# STUDIO_ANTHROPIC_BASE_URL=          # only for an Anthropic-compatible gateway you operate
ELEVENLABS_API_KEY=
FAL_KEY=
# OmniVoice (open-source voice cloning/design TTS) running on this computer behind an
# OpenAI-compatible server (e.g. omnivoice-server or OmniVoice-local). Usually set in
# Settings → OmniVoice instead. The key is only needed if your server requires one.
# OMNIVOICE_BASE_URL=http://127.0.0.1:3900/v1   # OmniVoice Studio app (or http://127.0.0.1:8000 for omnivoice-server)
# OMNIVOICE_MODEL=
# OMNIVOICE_API_KEY=
# Free stock footage search (Assets → Find free footage). Internet Archive and Wikimedia Commons
# need no key. Free keys: https://www.pexels.com/api/ and https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Rendering --------------------------------------------------------------
# Chromium headless shell used by HyperFrames (auto-detected under PLAYWRIGHT_BROWSERS_PATH).
# HYPERFRAMES_CHROME_PATH=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
PUPPETEER_SKIP_DOWNLOAD=true
RENDER_WORKERS=2
WORKER_CONCURRENCY=2
PREVIEW_SCALE=0.5

# Generation (fal). Endpoint ids and prices are configured per workspace in Settings.
# FAL_QUEUE_BASE_URL=https://queue.fal.run
# OpenRouter image models (keyframes/image shots; never used for Claude). Key via Settings or:
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=            # tests only: a local stand-in (ignored in production)
# FAL_JWKS_URL=https://rest.alpha.fal.ai/.well-known/jwks.json
# FAL_WEBHOOK_SIGNATURE=on            # "off" only for local fixtures
# FAL_WAIT_MAX_SEC=1800               # how long one job waits before re-checking later
# PUBLIC_BASE_URL=https://studio.example.com   # enables provider webhooks (polling otherwise)
# VS_TEST_TRUSTED_OUTPUT=             # tests only: host:port of a local fake provider (ignored in production)

# --- Speech -------------------------------------------------------------------
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# Local Whisper via whisper.cpp (both paths required to enable it):
# WHISPER_CPP_BIN=/usr/local/bin/whisper-cli
# WHISPER_CPP_MODEL=/models/ggml-base.en.bin

# --- Graphics backends --------------------------------------------------------
# Redraw is a private, licensed package: point at the owner's release tarball (never commit it).
# REDRAW_TARBALL=./vendor/redraw/redraw-1.3.3.tgz
# REDRAW_SHA256=<sha256 of that tarball>
# REDRAW_DISABLED=1                   # force the capability off (tests of A29 routing)

# --- Limits and operations ----------------------------------------------------
# MAX_UPLOAD_BYTES=524288000
# MAX_SOURCE_SECONDS=600
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# KEEP_WORK_DIRS=1                    # keep per-job work directories for debugging
# SKIP_PROXIES=1                      # skip preview proxies for large sources
# ALLOW_BUILTIN_TEMPLATE_REWRITE=1    # dev only: allow changing a published built-in template version
# DB_POOL_MAX=10
# QUEUE_NAME=vs-jobs
# DELETE_RECOVERY_DAYS=7              # how long deleted projects can be restored
# APP_ENCRYPTION_KEY_PREVIOUS=        # only during a key rotation (scripts/rotate-secrets.ts)

# --- Event collections (FR-16) --------------------------------------------------
# COLLECTION_MAX_FILES=500
# COLLECTION_MAX_FILE_BYTES=8589934592        # 8 GiB per recording
# COLLECTION_MAX_TOTAL_BYTES=214748364800     # 200 GiB per collection
# COLLECTION_MAX_SOURCE_SECONDS=14400         # 4 h per recording
# COLLECTION_IMPORT_ROOT=/srv/event-footage   # optional read-only server folder (owners only)
# STT_PRICE_USD_PER_HOUR=                     # your speech-to-text price, used for estimates only

# --- Draft quality review (FR-18) -----------------------------------------------
# QA_MAX_REPAIR_PASSES=2
# QA_MAX_JOB_SEC=900

# --- Tests --------------------------------------------------------------------------
# FAKE_FAL_PORT=3910 (scripts/fake-fal.ts), PW_CHROMIUM=<chromium path for Playwright>
# E2E_BASE_URL=http://127.0.0.1:3000, E2E_PROD_URL=http://127.0.0.1:3100
# BENCH_FILES=120 BENCH_SECONDS=120 BENCH_UPLOAD_CONCURRENCY=4 BENCH_BASE_URL=http://127.0.0.1:3000

# --- TEST ONLY: Claude Agent SDK test double (ignored when NODE_ENV=production) ---
# STUDIO_CLAUDE_SDK_DOUBLE=/abs/path/to/scripts/fake-claude-sdk.mjs
# STUDIO_CLAUDE_SDK_DOUBLE_STATE=/abs/path/to/data/fake-claude.json

# --- TEST ONLY: footage API stand-in (scripts/fake-footage.ts; ignored when NODE_ENV=production) ---
# FOOTAGE_IA_BASE_URL=http://127.0.0.1:3901/ia
# FOOTAGE_WIKIMEDIA_BASE_URL=http://127.0.0.1:3901/wm
# FOOTAGE_PEXELS_BASE_URL=http://127.0.0.1:3901/px
# FOOTAGE_PIXABAY_BASE_URL=http://127.0.0.1:3901/pb
# (and add 127.0.0.1:3901 to VS_TEST_TRUSTED_OUTPUT)
# ElevenLabs API stand-in (scripts/fake-omnivoice.ts also serves /el): ELEVENLABS_BASE_URL=http://127.0.0.1:3902/el

# Images with ChatGPT (Settings → Providers): the local Codex CLI signed in with ChatGPT.
# Set only if `codex` is not on the worker's PATH.
# CODEX_PATH=/usr/local/bin/codex

# Picture hosting (your S3-compatible bucket, for sending frames to Lanternist): bucket, address and
# access key id go in Settings → Picture hosting; the secret may live here instead of Settings.
# SHARE_SECRET_ACCESS_KEY=
